{
  "name": "StockMovement",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "title": "Produto ID"
    },
    "product_name": {
      "type": "string",
      "title": "Produto"
    },
    "type": {
      "type": "string",
      "title": "Tipo",
      "enum": [
        "entrada",
        "saida",
        "ajuste"
      ]
    },
    "quantity": {
      "type": "number",
      "title": "Quantidade"
    },
    "reason": {
      "type": "string",
      "title": "Motivo"
    },
    "client_id": {
      "type": "string",
      "title": "ID Local"
    },
    "terminal_id": {
      "type": "string",
      "title": "Terminal"
    },
    "company_id": {
      "type": "string",
      "title": "Empresa ID"
    }
  },
  "required": [
    "product_id",
    "type",
    "quantity"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}