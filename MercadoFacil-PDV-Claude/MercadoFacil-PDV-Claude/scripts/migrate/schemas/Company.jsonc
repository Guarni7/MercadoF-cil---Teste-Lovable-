{
  "type": "object",
  "name": "Company",
  "properties": {
    "trade_name": {
      "type": "string",
      "title": "Nome fantasia"
    },
    "legal_name": {
      "type": "string",
      "title": "Raz\u00e3o social"
    },
    "document": {
      "type": "string",
      "title": "CNPJ/CPF"
    },
    "phone": {
      "type": "string",
      "title": "Telefone"
    },
    "email": {
      "type": "string",
      "title": "E-mail"
    },
    "cep": {
      "type": "string",
      "title": "CEP"
    },
    "address": {
      "type": "string",
      "title": "Logradouro"
    },
    "address_number": {
      "type": "string",
      "title": "N\u00famero"
    },
    "complement": {
      "type": "string",
      "title": "Complemento"
    },
    "neighborhood": {
      "type": "string",
      "title": "Bairro"
    },
    "city": {
      "type": "string",
      "title": "Cidade"
    },
    "state": {
      "type": "string",
      "title": "UF"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "active",
        "suspended",
        "rejected"
      ],
      "default": "pending"
    },
    "plan": {
      "type": "string",
      "title": "Plano",
      "enum": [
        "mei",
        "simples",
        "sn_mobtef"
      ]
    },
    "plan_status": {
      "type": "string",
      "title": "Status do plano",
      "enum": [
        "none",
        "trial",
        "active",
        "expired",
        "canceled"
      ],
      "default": "none"
    },
    "plan_expires_at": {
      "type": "string",
      "title": "Plano expira em",
      "format": "date-time"
    },
    "trial_started_at": {
      "type": "string",
      "title": "In\u00edcio do trial",
      "format": "date-time"
    },
    "owner_user_id": {
      "type": "string",
      "title": "Dono (user id)"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es internas"
    }
  },
  "required": [
    "trade_name",
    "document",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.company_id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}