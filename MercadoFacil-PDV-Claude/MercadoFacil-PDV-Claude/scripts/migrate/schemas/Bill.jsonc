{
  "name": "Bill",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "title": "Tipo",
      "enum": [
        "pagar",
        "receber"
      ]
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "amount": {
      "type": "number",
      "title": "Valor"
    },
    "due_date": {
      "type": "string",
      "title": "Vencimento",
      "format": "date"
    },
    "paid": {
      "type": "boolean",
      "title": "Pago",
      "default": false
    },
    "paid_at": {
      "type": "string",
      "title": "Pago em",
      "format": "date"
    },
    "category": {
      "type": "string",
      "title": "Categoria"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    },
    "recurring": {
      "type": "boolean",
      "title": "Recorrente",
      "default": false
    },
    "company_id": {
      "type": "string",
      "title": "Empresa ID"
    }
  },
  "required": [
    "type",
    "amount",
    "due_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}