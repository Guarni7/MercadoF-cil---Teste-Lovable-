{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "title": "Tipo"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "severity": {
      "type": "string",
      "title": "Severidade"
    },
    "amount": {
      "type": "number",
      "title": "Valor"
    },
    "changeAmount": {
      "type": "number",
      "title": "Troco"
    },
    "saleNumber": {
      "type": "number",
      "title": "Venda"
    },
    "cashRegisterId": {
      "type": "string",
      "title": "Caixa"
    },
    "paymentMethod": {
      "type": "string",
      "title": "Pagamento"
    },
    "details": {
      "type": "string",
      "title": "Detalhes"
    },
    "company_id": {
      "type": "string",
      "title": "Empresa ID"
    }
  },
  "required": [
    "type",
    "description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}