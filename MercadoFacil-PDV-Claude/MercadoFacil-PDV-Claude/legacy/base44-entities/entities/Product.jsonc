{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nome"
    },
    "code": {
      "type": "string",
      "title": "C\u00f3digo"
    },
    "barcode": {
      "type": "string",
      "title": "EAN"
    },
    "reference": {
      "type": "string",
      "title": "Refer\u00eancia"
    },
    "price": {
      "type": "number",
      "title": "Pre\u00e7o de Venda"
    },
    "cost": {
      "type": "number",
      "title": "Custo",
      "default": 0
    },
    "average_cost": {
      "type": "number",
      "title": "Custo M\u00e9dio",
      "default": 0
    },
    "stock": {
      "type": "number",
      "title": "Estoque",
      "default": 0
    },
    "min_stock": {
      "type": "number",
      "title": "Estoque M\u00ednimo",
      "default": 5
    },
    "category": {
      "type": "string",
      "title": "Grupo"
    },
    "subcategory": {
      "type": "string",
      "title": "Subgrupo"
    },
    "brand": {
      "type": "string",
      "title": "Marca"
    },
    "channels": {
      "type": "string",
      "title": "Canais"
    },
    "unit": {
      "type": "string",
      "title": "Unidade",
      "default": "UN",
      "enum": [
        "UN",
        "KG",
        "LT",
        "CX",
        "PCT",
        "M",
        "G",
        "ML"
      ]
    },
    "image_url": {
      "type": "string",
      "title": "Imagem"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    },
    "promo": {
      "type": "boolean",
      "title": "Promo\u00e7\u00e3o",
      "default": false
    },
    "fiscal_info": {
      "type": "string",
      "title": "Info Fiscal"
    },
    "active": {
      "type": "boolean",
      "title": "Ativo",
      "default": true
    },
    "company_id": {
      "type": "string",
      "title": "Empresa ID"
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}